---
import type { GridColumn } from "../data/grids";
import { referenceNumber } from "../data/references";

interface Props {
  columns: GridColumn[];
}

const { columns } = Astro.props;
---

<div
  class="grid gap-2 text-sm font-medium"
  style={`grid-template-columns: repeat(${columns.length}, minmax(0, 1fr));`}
>
  {
    columns.map((column) => (
      <div class="flex items-center gap-2 px-1">
        <span>
          {column.label}
          {column.cite && (
            <a
              href={`#bib-${column.cite}`}
              class="ml-1 font-normal text-zinc-500 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400"
            >
              [{referenceNumber(column.cite)}]
            </a>
          )}
        </span>
        {column.ours && (
          <span class="rounded-full bg-blue-600 px-2 py-0.5 text-[0.65rem] font-semibold tracking-wide text-white uppercase">
            Ours
          </span>
        )}
      </div>
    ))
  }
</div>
